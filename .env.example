# Server
NODE_ENV=development
PORT=5000
INSTANCE_ID=backend-1
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/virtual-queue
USE_IN_MEMORY_DB=false

# Redis (Optional - falls back to MongoDB atomic counters if unavailable)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=change-this-to-a-strong-64-char-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-strong-64-char-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR Signing
QR_SIGNING_SECRET=change-this-qr-hmac-secret-in-production

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@virtualqueue.app

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@virtualqueue.app

# Travel Time (OpenRouteService)
OPENROUTESERVICE_API_KEY=

# Optional AI Assistant (OpenAI / Gemini)
AI_PROVIDER=mock
AI_API_KEY=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:5000
